# Cyber Emergency Response System (CERS) Environment Config

# Sarvam AI API key for IVR voice prompt generation
sarvam_api=your_sarvam_api_key_here

# Officer console access token. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CERS_OFFICER_TOKEN=change-me-to-a-long-random-token

# Optional: separate HMAC key for signed officer session cookies.
# If omitted, a key is derived from CERS_OFFICER_TOKEN.
CERS_SECRET_KEY=

# Set to 1 when the app is served over HTTPS so the session cookie is Secure.
CERS_COOKIE_SECURE=0

# Optional: comma-separated browser origins allowed to call the API.
# Leave empty for same-origin-only deployments.
CERS_ALLOWED_ORIGINS=

# Optional TURN relay for WebRTC across restrictive/mobile networks.
# CERS_TURN_URL=turn:turn.example.com:3478
# CERS_TURN_USERNAME=cers
# CERS_TURN_CREDENTIAL=replace-me

# Limits and maintenance
CERS_MAX_RECORDING_BYTES=26214400
CERS_MAX_ACTIVE_CALLS=500
CERS_CALL_TTL_SECONDS=3600
CERS_CLEANUP_INTERVAL_SECONDS=300

# Optional Cloud Storage (Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key
# SUPABASE_BUCKET=recordings

# Hugging Face Speech Emotion Recognition
# HUGGINGFACE_API_KEY=hf_your_token_here
# HUGGINGFACE_MODEL=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
