# Cyber Emergency Response System (CERS) Environment Config
#
# Copy to .env and fill in your own values. There is no default officer
# password, and the published sample values below are placeholders — the
# gateway will refuse to start until you set your own credentials.

# --- Officer console access (REQUIRED) ---------------------------------
# Option A (simplest): one shared password, sign in with any name.
# Generate long random values, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
CERS_OFFICER_PASSWORD=replace-with-a-long-random-password
CERS_OFFICER_TOKEN=
#
# Option B (per-officer accounts): when set, ONLY these names may sign in,
# and each must present its own secret. This makes the officer_id on each
# recording a verified identity instead of a self-declared label.
# An officer may accept several secrets, separated by "|" (e.g. a primary
# and a backup): "Name:secretA|secretB". The login page shows the names as a
# dropdown. Use long random values — short passwords are a brute-force gift.
# CERS_OFFICERS=Mayuresh Alpha:replace-with-strong-secret|replace-with-backup-secret,Tejas Delta:replace-with-strong-secret

# Optional: separate HMAC key for signed officer session cookies.
CERS_SECRET_KEY=

# Set to 1 when the app is served over HTTPS so the session cookie is Secure
# (also enables HSTS).
CERS_COOKIE_SECURE=0

# Optional: comma-separated browser origins allowed to call the API.
# Leave empty for same-origin-only deployments.
CERS_ALLOWED_ORIGINS=

# --- WebRTC -------------------------------------------------------------
# CERS_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# CERS_TURN_URL=turn:turn.example.com:3478
# CERS_TURN_USERNAME=cers
# CERS_TURN_CREDENTIAL=replace-with-a-long-random-value

# --- Limits and maintenance --------------------------------------------
CERS_MAX_RECORDING_BYTES=26214400
# Cap for the short triage statement uploaded before dispatch (5 MB).
CERS_MAX_TRIAGE_BYTES=5242880
CERS_MAX_ACTIVE_CALLS=500
CERS_CALL_TTL_SECONDS=3600
CERS_CLEANUP_INTERVAL_SECONDS=300
# Grace period before a dropped caller socket ends the session.
CERS_CALLER_DISCONNECT_GRACE_SECONDS=15
# Purge archived recordings older than N days. 0 = keep forever (default).
CERS_RECORDING_RETENTION_DAYS=0

# --- Escalation ---------------------------------------------------------
# A call at/above this score, unclaimed for this long, raises an alarm.
CERS_ESCALATION_PRIORITY=85
CERS_ESCALATION_AFTER_SECONDS=30
CERS_ESCALATION_SWEEP_SECONDS=5

# --- Runtime discipline -------------------------------------------------
# Call state is in-memory, so exactly one worker may run. Set to 1 only if you
# accept that atomic call claiming is not safe across workers.
CERS_ALLOW_MULTI_WORKER=0
# Only for throwaway demos: run with credentials that match the sample file.
# CERS_ALLOW_PUBLISHED_CREDENTIALS=1
# Optional: where the single-worker lock file lives.
# CERS_WORKER_LOCK=.cers.worker.lock
CERS_LOG_LEVEL=INFO

# --- Sarvam AI (Indic speech-to-text + IVR voice generation) -----------
# sarvam_api is the primary key; the optional sarvam_api2 backup is used
# only when sarvam_api is unset (it is not a request-level failover).
sarvam_api=
# sarvam_api2=
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE_CODE=unknown

# --- Groq (semantic triage + forensic dossier) -------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- AI resilience ------------------------------------------------------
# 1 = never call a provider; use the deterministic pipeline (demos, CI, outage).
CERS_AI_OFFLINE=0
CERS_PROVIDER_ATTEMPTS=2
CERS_PROVIDER_BACKOFF_SECONDS=0.4
CERS_PROVIDER_BREAKER_THRESHOLD=5
CERS_PROVIDER_BREAKER_COOLDOWN=60

# --- Speech Emotion Recognition ---------------------------------------
# Dedicated AWS EC2 microservice (preferred source). Put the EC2 host and
# the shared token in your own environment, never in this file.
# AWS_EMOTION_URL=https://<your-ec2-host>:8000/predict
# A shared bearer token; set the same value as SER_API_KEY on the EC2 instance.
# CERS_SER_API_KEY=replace-with-a-long-random-token
# Hugging Face Space fallback.
# HUGGINGFACE_API_KEY=hf_your_token_here
# HF_SPACE_ID=mindfoldz0/cers-voice-emotion

# --- Optional cloud storage (Supabase) ---------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key
# SUPABASE_BUCKET=recordings
